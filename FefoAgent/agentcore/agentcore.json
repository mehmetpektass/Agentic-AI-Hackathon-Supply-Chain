{
  "name": "FefoAgent",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agent",
      "build": "CodeZip",
      "modelProvider": "Bedrock",
      "entrypoint": "main.py",
      "codeLocation": "app/agent",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "UNIFIED_TRACES_DESTINATION_ENABLED",
          "value": "true"
        },
        {
          "name": "REPORTS_BUCKET",
          "value": "fefo-862714237836-us-east-1"
        },
        {
          "name": "MODEL_ID",
          "value": "global.anthropic.claude-sonnet-5"
        },
        {
          "name": "MCP_BACKEND",
          "value": "fefo_mcp"
        }
      ],
      "additionalPolicies": [
        "policies/s3-reports.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "agentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ]
}
